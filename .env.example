# Copy to .env.local and fill in. Never commit .env.local.
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: where messages are delivered (defaults to GMAIL_USER)
CONTACT_TO=you@gmail.com
